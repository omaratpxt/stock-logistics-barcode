<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="stock_barcodes.BarcodeCameraButton">
        <button
            t-if="showCameraButton"
            type="button"
            class="btn o_barcode_camera_button"
            t-att-class="props.className"
            t-att-title="buttonTitle"
            t-on-click="onClickCamera"
        >
            <i class="fa fa-camera" />
        </button>
    </t>

</templates>
