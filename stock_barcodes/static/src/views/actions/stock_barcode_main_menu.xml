<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <div
        t-name="stock_barcodes.MainMenu"
        class="d-flex flex-column stock-barcodes-main-menu p-4"
    >
        <div
            class="d-flex o_stock_barcode_header_home justify-content-between align-items-center w-100"
        >
            <a
                href="#"
                class="o_stock_barcode_header_back"
                t-on-click="mainMenuHome"
            >
                <i class="fa fa-chevron-left" />
            </a>
            <h1 class="mb-0">Barcode Scanner</h1>
            <span class="o_stock_barcode_header_spacer" />
        </div>
        <div
            class="alert o_stock_barcode_description w-100 mt-3 mb-0"
            role="alert"
        >
            <i class="fa fa-barcode me-2" />
            <span>Scan a barcode action</span>
        </div>
        <div
            class="d-flex justify-content-center w-100 mt-3 o_stock_barcode_buttons"
        >
            <div class="row w-100 g-3">
                <t
                    t-foreach="this.barcodeActions"
                    t-as="barcodeAction"
                    t-key="barcodeAction.id"
                >
                    <div class="col-12 col-md-6">
                        <button
                            class="o_stock_barcode_tile btn w-100 d-flex flex-column align-items-center justify-content-center gap-2"
                            t-on-click="() => this.openAction(barcodeAction.id)"
                        >
                            <i
                                t-attf-class="#{barcodeAction.icon_class or 'fa fa-barcode'} o_stock_barcode_tile_icon"
                            />
                            <span class="o_stock_barcode_tile_label">
                                <t t-out="barcodeAction.name" />
                            </span>
                        </button>
                    </div>
                </t>
            </div>
        </div>
    </div>
</templates>
